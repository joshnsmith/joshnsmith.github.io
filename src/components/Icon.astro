---
import type { IconNode } from 'lucide';
interface Props { node: IconNode; size?: number; class?: string; }
const { node, size = 18, class: className } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class:list={['lucide-icon', className]}>{node.map(([Tag, attributes]) => <Tag {...attributes} />)}</svg>
